<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base app theme. The UI is fully Compose; this keeps the window edge-to-edge
         with a transparent system bars so the in-app status bar matches the design. -->
    <style name="Theme.Tame" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/tame_surface</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
